<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>David Sommerhalder</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <SpaRoot>..\..\frontend\koemmerle-at-home\</SpaRoot>
    <SpaDist>$(SpaRoot)dist\koemmerle-at-home\browser\</SpaDist>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageReference Include="Microsoft.Playwright" Version="1.*" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="playwright-session\**;migros-session\**;koemmerleathome.db*" />
    <None Remove="playwright-session\**;migros-session\**;koemmerleathome.db*" />
  </ItemGroup>

  <Target Name="BuildFrontend" Condition="'$(BuildFrontend)' != 'false'">
    <Message Importance="high" Text="Building Angular frontend for publish..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci --legacy-peer-deps" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build -- --configuration production" />
  </Target>

  <Target Name="IncludeFrontendFiles" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="BuildFrontend">
    <Error Condition="!Exists('$(SpaDist)index.html')" Text="Angular production build was not found at $(SpaDist). Run npm run build -- --configuration production in $(SpaRoot), or publish with BuildFrontend enabled." />
    <ItemGroup>
      <DistFiles Include="$(SpaDist)**\*" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
